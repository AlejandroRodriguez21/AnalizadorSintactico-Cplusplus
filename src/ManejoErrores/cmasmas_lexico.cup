
/* CENTENO DOMINGUEZ EDGAR YAIR, RAMOS GUTIERREZ RODRIGO, RODRIGUEZ ROMERO ALEJANDRO */
package ManejoErrores;
import java_cup.runtime.*;

parser code {:
    private final TablaSimbolos tabla = new TablaSimbolos();

    public TablaSimbolos getTablaSimbolos() { return tabla; }

    @Override
    public void report_error(String message, Object info) {
        if (info instanceof java_cup.runtime.Symbol) {
            java_cup.runtime.Symbol s = (java_cup.runtime.Symbol) info;
            if (s.sym != sym.error) {
                System.err.println("Error sintactico en linea " + (s.left + 1)
                    + ", columna " + (s.right + 1)
                    + ": token inesperado '" + s.value + "'");
            }
        }
    }

    @Override
    public void report_fatal_error(String message, Object info) {
        System.err.println("Error fatal irrecuperable. Abortando.");
        System.exit(1);
    }
:};

/* TERMINALES ORIGINALES */
terminal INT, FLOAT, DOUBLE, CHAR, VOID, BOOL, LONG, SHORT, STRING;
terminal IF, ELSE, SWITCH, CASE, DEFAULT, FOR, WHILE, DO, BREAK, CONTINUE;
terminal CLASS, STRUCT, PUBLIC, PRIVATE, PROTECTED, THIS, NEW, DELETE, RETURN, USING, NAMESPACE, STD, COUT, CIN, ENDL, IMPORT, CONST;
terminal LEER, ESCRIBIR;
terminal IGUAL_IGUAL, DISTINTO, MAYOR_IGUAL, MENOR_IGUAL, AND, OR, NOT;
terminal MAS, MENOS, POR, ENTRE, MODULO, IGUAL, MENOR, MAYOR, MENOR_MENOR, MAYOR_MAYOR;
terminal PUNTO_COMA, COMA, PUNTO, DOS_PUNTOS, PARENTESIS_A, PARENTESIS_C, CORCHETE_A, CORCHETE_C, LLAVE_A, LLAVE_C;
terminal String IDENTIFICADOR, CADENA;
terminal Integer ENTERO;
terminal Double DECIMAL;
terminal TRUE, FALSE;

/* NO TERMINALES ORIGINALES Y DE ACTIVIDADES 7-8 */
non terminal archivo, paquete_opcional, lista_importaciones, importacion, clase_principal, lista_clases;
non terminal cuerpo_clase, lista_elementos_clase, elemento_clase, modificador_acceso, declaracion_objeto;
non terminal atributo_variable, constante;
non terminal String tipo_dato, valor;
non terminal ManejoErrores.ManejadorTipos.Expresion expresion, condicion;
non terminal java.util.List lista_identificadores;
non terminal Boolean lista_sentencias, sentencia, bloque, retorno, estructura_control, seleccion_simple, seleccion_doble, seleccion_multiple, ciclo_mientras, ciclo_hacer_mientras, ciclo_para;
non terminal lectura, escritura, asignacion, lista_elementos;
non terminal lista_casos, caso, defecto, cabecera_switch, inicio_if, inicio_caso, inicio_defecto, inicio_while, inicio_do, comienzo_actualizacion_for, comienzo_cuerpo_for;
non terminal java.util.List inicio_else;
non terminal actualizacion_para, dec_var_local, inicio_ciclo, inicio_for, fin_firma;
non terminal metodo, cabecera_metodo, parametros_optativos, lista_parametros, parametro, inicio_bloque;
non terminal java.util.List lista_argumentos_optativos, lista_argumentos;
non terminal ManejoErrores.ManejadorTipos.Expresion llamada_metodo;

precedence right IGUAL;
precedence left OR;
precedence left AND;
precedence left IGUAL_IGUAL, DISTINTO, MAYOR, MENOR, MAYOR_IGUAL, MENOR_IGUAL;
precedence left MAS, MENOS;
precedence left POR, ENTRE, MODULO;
precedence right NOT;
precedence left ELSE;

start with archivo;

archivo ::= paquete_opcional lista_importaciones lista_clases
          {: System.out.println("Analisis sintactico finalizado correctamente"); :} ;
paquete_opcional ::= USING NAMESPACE IDENTIFICADOR PUNTO_COMA | USING NAMESPACE STD PUNTO_COMA | /* vacio */ ;
lista_importaciones ::= lista_importaciones importacion | /* vacio */ ;
importacion ::= IMPORT IDENTIFICADOR PUNTO_COMA ;

lista_clases ::= lista_clases clase_principal | clase_principal ;

/* Registro de clases y ambitos: actividades 9 y 11. */
clase_principal ::= CLASS IDENTIFICADOR:n LLAVE_A
                {: parser.getTablaSimbolos().abrirClase(n, nleft + 1, nright + 1); :}
                cuerpo_clase LLAVE_C
                {: parser.getTablaSimbolos().cerrarClase(); :}
                | error LLAVE_C
                {: System.err.println("-> Recuperacion: Se omitio clase mal formada."); :} ;

cuerpo_clase ::= lista_elementos_clase | /* vacio */ ;
lista_elementos_clase ::= lista_elementos_clase elemento_clase | elemento_clase ;
modificador_acceso ::= PUBLIC DOS_PUNTOS {: parser.getTablaSimbolos().cambiarAcceso("public"); :}
                   | PRIVATE DOS_PUNTOS {: parser.getTablaSimbolos().cambiarAcceso("private"); :}
                   | PROTECTED DOS_PUNTOS {: parser.getTablaSimbolos().cambiarAcceso("protected"); :} ;
elemento_clase ::= modificador_acceso
                 | atributo_variable
                 | constante
                 | metodo
                 | retorno
                 | tipo_dato IDENTIFICADOR error:e bloque
                   {: System.err.println("Error sintactico en linea " + (eleft + 1) + ": se esperaba '(' despues del nombre del metodo."); :}
                 | VOID IDENTIFICADOR error:e bloque
                   {: System.err.println("Error sintactico en linea " + (eleft + 1) + ": se esperaba '(' despues del nombre del metodo."); :}
                 | error PUNTO_COMA
                   {: System.err.println("-> Recuperacion: Declaracion de clase invalida."); :} ;

/* ACTIVIDAD 8: metodos. ACTIVIDAD 9: registro de su nombre y ambito. */
metodo ::= cabecera_metodo parametros_optativos PARENTESIS_C fin_firma bloque:devuelve
         {: parser.getTablaSimbolos().cerrarMetodo(devuelve);
            System.out.println("Regla reconocida: definicion_metodo"); :} ;
fin_firma ::= /* vacio */ {: parser.getTablaSimbolos().finalizarFirma(); :} ;
cabecera_metodo ::= tipo_dato:t IDENTIFICADOR:n PARENTESIS_A
         {: parser.getTablaSimbolos().abrirMetodo(n, t, nleft + 1, nright + 1); :}
         | VOID IDENTIFICADOR:n PARENTESIS_A
         {: parser.getTablaSimbolos().abrirMetodo(n, "void", nleft + 1, nright + 1); :} ;

parametros_optativos ::= lista_parametros
                       {: System.out.println("Regla reconocida: metodo_con_parametros"); :}
                       | /* vacio */
                       {: System.out.println("Regla reconocida: metodo_sin_parametros"); :} ;
lista_parametros ::= lista_parametros COMA parametro
                   | lista_parametros COMA error:e
                     {: System.err.println("Error sintactico en linea " + (eleft + 1) + ": se esperaba un parametro despues de ','."); :}
                   | parametro
                     {: System.out.println("Regla reconocida: lista_parametros"); :} ;
parametro ::= tipo_dato:t IDENTIFICADOR:n
            {: parser.getTablaSimbolos().registrarParametro(n,t,nleft+1,nright+1); :}
            | tipo_dato error:e
              {: System.err.println("Error sintactico en linea " + (eleft + 1) + ": se esperaba un identificador para el parametro."); :} ;

/* Firmas y tipos de argumentos, incluidos accesos mediante objeto. */
llamada_metodo ::= IDENTIFICADOR:n PARENTESIS_A lista_argumentos_optativos:args PARENTESIS_C
    {: RESULT=parser.getTablaSimbolos().llamarMetodo(null,n,args,nleft+1,nright+1);
       System.out.println("Regla reconocida: llamada_metodo"); :}
    | IDENTIFICADOR:obj PUNTO IDENTIFICADOR:n PARENTESIS_A lista_argumentos_optativos:args PARENTESIS_C
    {: RESULT=parser.getTablaSimbolos().llamarMetodo(obj,n,args,nleft+1,nright+1);
       System.out.println("Regla reconocida: llamada_metodo"); :} ;
lista_argumentos_optativos ::= lista_argumentos:args {: RESULT=args; :}
    | /* vacio */ {: RESULT=new java.util.ArrayList(); :} ;
lista_argumentos ::= expresion:e
    {: java.util.List args=new java.util.ArrayList(); args.add(e); RESULT=args;
       System.out.println("Regla reconocida: lista_argumentos"); :}
    | lista_argumentos:args COMA expresion:e
    {: args.add(e); RESULT=args; :}
    | lista_argumentos:args COMA error:e
    {: System.err.println("Error sintactico en linea "+(eleft+1)+": argumento incompleto."); RESULT=args; :} ;
retorno ::= RETURN:op expresion:e PUNTO_COMA
    {: int antes = parser.getTablaSimbolos().getErrores();
       parser.getTablaSimbolos().validarRetorno(e,opleft+1,opright+1);
       if (antes == parser.getTablaSimbolos().getErrores())
           parser.getTablaSimbolos().getCodigoIntermedio().retornar(e);
       RESULT=parser.getTablaSimbolos().retornoValido(e);
       System.out.println("Regla reconocida: retorno con expresion"); :}
    | RETURN:op PUNTO_COMA
    {: int antes = parser.getTablaSimbolos().getErrores();
       parser.getTablaSimbolos().validarRetorno(null,opleft+1,opright+1);
       if (antes == parser.getTablaSimbolos().getErrores())
           parser.getTablaSimbolos().getCodigoIntermedio().retornar(null);
       RESULT=parser.getTablaSimbolos().retornoValido(null);
       System.out.println("Regla reconocida: retorno sin expresion"); :}
    | RETURN error:e PUNTO_COMA
    {: System.err.println("Error sintactico en linea "+(eleft+1)+": retorno mal formado."); RESULT=false; :} ;

/* Garantia de retorno para caminos de control, conservando ambitos. */
inicio_bloque ::= /* vacio */ {: parser.getTablaSimbolos().abrirBloque(); :} ;
bloque ::= LLAVE_A inicio_bloque lista_sentencias:r LLAVE_C
    {: parser.getTablaSimbolos().cerrarBloque(); RESULT=r;
       System.out.println("Regla reconocida: bloque"); :}
    | LLAVE_A inicio_bloque lista_sentencias:r error:e
    {: parser.getTablaSimbolos().cerrarBloque(); RESULT=false;
       System.err.println("Error sintactico en linea "+(eleft+1)+": se esperaba '}'."); :} ;
lista_sentencias ::= lista_sentencias:a sentencia:b {: RESULT=a || b; :}
                  | /* vacio */ {: RESULT=false; :} ;
sentencia ::= lectura {: RESULT=false; :}
            | escritura {: RESULT=false; :}
            | asignacion {: RESULT=false; :}
            | declaracion_objeto {: RESULT=false; :}
            | dec_var_local {: RESULT=false; :}
            | estructura_control:e {: RESULT=e; :}
            | retorno:r {: RESULT=r; :}
            | llamada_metodo:e PUNTO_COMA
              {: parser.getTablaSimbolos().getCodigoIntermedio().invocar(e); RESULT=false; :}
            | IDENTIFICADOR PARENTESIS_A lista_argumentos_optativos error PUNTO_COMA
              {: System.err.println("Error sintactico: se esperaba ')' al finalizar los argumentos."); RESULT=false; :}
            | IDENTIFICADOR PUNTO_COMA
              {: System.err.println("Error sintactico: se esperaba '(' para iniciar la llamada al metodo."); RESULT=false; :}
            | BREAK:kw PUNTO_COMA
              {: int antes=parser.getTablaSimbolos().getErrores();
                 parser.getTablaSimbolos().validarBreak(kwleft+1,kwright+1);
                 if (antes == parser.getTablaSimbolos().getErrores())
                     parser.getTablaSimbolos().getCodigoIntermedio().romper();
                 RESULT=false; :}
            | CONTINUE:kw PUNTO_COMA
              {: int antes=parser.getTablaSimbolos().getErrores();
                 parser.getTablaSimbolos().validarContinue(kwleft+1,kwright+1);
                 if (antes == parser.getTablaSimbolos().getErrores())
                     parser.getTablaSimbolos().getCodigoIntermedio().continuar();
                 RESULT=false; :}
            | bloque:r {: RESULT=r; :}
            | ELSE bloque
              {: System.err.println("Error sintactico: 'sino' sin 'si'."); RESULT=false; :}
            | error PUNTO_COMA
              {: System.err.println("-> Recuperacion: Se omitio sentencia invalida."); RESULT=false; :} ;

declaracion_objeto ::= IDENTIFICADOR:tipo IDENTIFICADOR:n PUNTO_COMA
    {: parser.getTablaSimbolos().registrarObjeto(tipo,n,nleft+1,nright+1); :} ;
estructura_control ::= seleccion_simple:r {: RESULT=r; :}
                     | seleccion_doble:r {: RESULT=r; :}
                     | seleccion_multiple:r {: RESULT=r; :}
                     | ciclo_mientras:r {: RESULT=r; :}
                     | ciclo_hacer_mientras:r {: RESULT=r; :}
                     | ciclo_para:r {: RESULT=r; :} ;
condicion ::= expresion:e {: RESULT=e; :} ;
inicio_if ::= /* vacio */
    {: parser.getTablaSimbolos().getCodigoIntermedio().iniciarIf(); :} ;
inicio_else ::= /* vacio */
    {: RESULT=parser.getTablaSimbolos().getCodigoIntermedio().iniciarElse(); :} ;
seleccion_simple ::= IF:kw PARENTESIS_A condicion:e PARENTESIS_C inicio_if bloque
    {: ManejadorTipos.validarCondicion(parser.getTablaSimbolos(),"si",e,kwleft+1,kwright+1);
       parser.getTablaSimbolos().getCodigoIntermedio().finalizarIf(e);
       RESULT=false; :} ;
seleccion_doble ::= IF:kw PARENTESIS_A condicion:e PARENTESIS_C inicio_if bloque:a ELSE inicio_else:verdadero bloque:b
    {: ManejadorTipos.validarCondicion(parser.getTablaSimbolos(),"si",e,kwleft+1,kwright+1);
       parser.getTablaSimbolos().getCodigoIntermedio().finalizarIfElse(e,verdadero);
       RESULT=a && b; :} ;
cabecera_switch ::= SWITCH:kw PARENTESIS_A expresion:e PARENTESIS_C LLAVE_A
    {: parser.getTablaSimbolos().abrirSwitch(e,kwleft+1,kwright+1);
       parser.getTablaSimbolos().getCodigoIntermedio().iniciarSwitch(e); :} ;
seleccion_multiple ::= cabecera_switch lista_casos defecto LLAVE_C
    {: parser.getTablaSimbolos().cerrarSwitch();
       parser.getTablaSimbolos().getCodigoIntermedio().finalizarSwitch(); RESULT=false; :}
    | cabecera_switch lista_casos LLAVE_C
    {: parser.getTablaSimbolos().cerrarSwitch();
       parser.getTablaSimbolos().getCodigoIntermedio().finalizarSwitch(); RESULT=false; :} ;
lista_casos ::= lista_casos caso | caso ;
inicio_caso ::= /* vacio */
    {: parser.getTablaSimbolos().getCodigoIntermedio().iniciarCaso(); :} ;
caso ::= CASE:kw valor:v DOS_PUNTOS inicio_caso lista_sentencias
    {: parser.getTablaSimbolos().registrarCaso(v,kwleft+1,kwright+1);
       parser.getTablaSimbolos().getCodigoIntermedio().finalizarCaso(v); :}
    | CASE error DOS_PUNTOS inicio_caso lista_sentencias
    {: parser.getTablaSimbolos().getCodigoIntermedio().finalizarCaso("ERROR"); :} ;
inicio_defecto ::= /* vacio */
    {: parser.getTablaSimbolos().getCodigoIntermedio().iniciarDefecto(); :} ;
defecto ::= DEFAULT DOS_PUNTOS inicio_defecto lista_sentencias
    {: parser.getTablaSimbolos().getCodigoIntermedio().finalizarDefecto(); :} ;
inicio_ciclo ::= /* vacio */ {: parser.getTablaSimbolos().abrirCiclo(); :} ;
inicio_while ::= /* vacio */
    {: parser.getTablaSimbolos().getCodigoIntermedio().iniciarWhile(); :} ;
inicio_do ::= /* vacio */
    {: parser.getTablaSimbolos().getCodigoIntermedio().iniciarDoWhile(); :} ;
inicio_for ::= /* vacio */
    {: parser.getTablaSimbolos().abrirFor();
       parser.getTablaSimbolos().getCodigoIntermedio().iniciarFor(); :} ;
comienzo_actualizacion_for ::= /* vacio */
    {: parser.getTablaSimbolos().getCodigoIntermedio().iniciarActualizacionFor(); :} ;
comienzo_cuerpo_for ::= /* vacio */
    {: parser.getTablaSimbolos().getCodigoIntermedio().iniciarCuerpoFor(); :} ;
ciclo_mientras ::= WHILE:kw PARENTESIS_A condicion:e PARENTESIS_C inicio_ciclo inicio_while bloque
    {: parser.getTablaSimbolos().cerrarCiclo();
       ManejadorTipos.validarCondicion(parser.getTablaSimbolos(),"mientras",e,kwleft+1,kwright+1);
       parser.getTablaSimbolos().getCodigoIntermedio().finalizarWhile(e); RESULT=false; :}
    | WHILE PARENTESIS_A condicion error:e bloque
    {: RESULT=false; :} ;
ciclo_hacer_mientras ::= DO inicio_ciclo inicio_do bloque:r WHILE:kw PARENTESIS_A condicion:e PARENTESIS_C PUNTO_COMA
    {: parser.getTablaSimbolos().cerrarCiclo();
       ManejadorTipos.validarCondicion(parser.getTablaSimbolos(),"hacer-mientras",e,kwleft+1,kwright+1);
       parser.getTablaSimbolos().getCodigoIntermedio().finalizarDoWhile(e); RESULT=r; :} ;
ciclo_para ::= FOR:kw PARENTESIS_A inicio_for dec_var_local condicion:e PUNTO_COMA comienzo_actualizacion_for actualizacion_para PARENTESIS_C comienzo_cuerpo_for bloque
    {: parser.getTablaSimbolos().cerrarFor();
       ManejadorTipos.validarCondicion(parser.getTablaSimbolos(),"para",e,kwleft+1,kwright+1);
       parser.getTablaSimbolos().getCodigoIntermedio().finalizarFor(e); RESULT=false; :}
    | FOR:kw PARENTESIS_A inicio_for dec_var_local condicion:e PUNTO_COMA comienzo_actualizacion_for PARENTESIS_C comienzo_cuerpo_for bloque
    {: parser.getTablaSimbolos().cerrarFor();
       ManejadorTipos.validarCondicion(parser.getTablaSimbolos(),"para",e,kwleft+1,kwright+1);
       parser.getTablaSimbolos().getCodigoIntermedio().finalizarFor(e); RESULT=false; :} ;
actualizacion_para ::= IDENTIFICADOR:n IGUAL expresion:e
    {: parser.getTablaSimbolos().asignar(n,e,nleft+1,nright+1); :} ;
lectura ::= LEER PARENTESIS_A lista_identificadores:ids PARENTESIS_C PUNTO_COMA
    {: for(Object obj:ids) { TablaSimbolos.Referencia r=(TablaSimbolos.Referencia)obj;
         parser.getTablaSimbolos().verificarUso(r.id,r.linea,r.columna); } :} ;
escritura ::= ESCRIBIR PARENTESIS_A lista_elementos PARENTESIS_C PUNTO_COMA ;

/* Las variables locales requieren inicializacion; los atributos no. */
dec_var_local ::= tipo_dato:t IDENTIFICADOR:n IGUAL expresion:v PUNTO_COMA
                {: parser.getTablaSimbolos().registrarInicializado(n, "VARIABLE", t, v,
                         nleft + 1, nright + 1); :}
              | tipo_dato:t IDENTIFICADOR:n PUNTO_COMA
                {: parser.getTablaSimbolos().error(nleft + 1, nright + 1,
                         "La variable local '" + n + "' debe ser inicializada en su declaracion.");
                   parser.getTablaSimbolos().registrar(n, "VARIABLE", t,
                         "sin_inicializar", nleft + 1, nright + 1); :} ;
asignacion ::= IDENTIFICADOR:n IGUAL expresion:e PUNTO_COMA
             {: parser.getTablaSimbolos().asignar(n,e,nleft+1,nright+1); :}
             | IDENTIFICADOR:obj PUNTO IDENTIFICADOR:n IGUAL expresion:e PUNTO_COMA
             {: parser.getTablaSimbolos().asignarAtributo(obj,n,e,nleft+1,nright+1); :} ;
lista_elementos ::= expresion | lista_elementos COMA expresion ;

/* ACTIVIDAD 10: los no terminales propagan tipo y representacion textual. */
expresion ::= expresion:a MAS:op expresion:b
            {: RESULT = ManejadorTipos.aritmetica(parser.getTablaSimbolos(), "+", a, b, opleft + 1, opright + 1); :}
            | expresion:a MENOS:op expresion:b
            {: RESULT = ManejadorTipos.aritmetica(parser.getTablaSimbolos(), "-", a, b, opleft + 1, opright + 1); :}
            | expresion:a POR:op expresion:b
            {: RESULT = ManejadorTipos.aritmetica(parser.getTablaSimbolos(), "*", a, b, opleft + 1, opright + 1); :}
            | expresion:a ENTRE:op expresion:b
            {: RESULT = ManejadorTipos.aritmetica(parser.getTablaSimbolos(), "/", a, b, opleft + 1, opright + 1); :}
            | expresion:a MODULO:op expresion:b
            {: RESULT = ManejadorTipos.aritmetica(parser.getTablaSimbolos(), "%", a, b, opleft + 1, opright + 1); :}
            | expresion:a AND:op expresion:b
            {: RESULT = ManejadorTipos.logica(parser.getTablaSimbolos(), "&&", a, b, opleft + 1, opright + 1); :}
            | expresion:a OR:op expresion:b
            {: RESULT = ManejadorTipos.logica(parser.getTablaSimbolos(), "||", a, b, opleft + 1, opright + 1); :}
            | NOT:op expresion:e
            {: RESULT = ManejadorTipos.negacion(parser.getTablaSimbolos(), e, opleft + 1, opright + 1); :}
            | expresion:a MAYOR:op expresion:b
            {: RESULT = ManejadorTipos.relacional(parser.getTablaSimbolos(), ">", a, b, opleft + 1, opright + 1); :}
            | expresion:a MENOR:op expresion:b
            {: RESULT = ManejadorTipos.relacional(parser.getTablaSimbolos(), "<", a, b, opleft + 1, opright + 1); :}
            | expresion:a MAYOR_IGUAL:op expresion:b
            {: RESULT = ManejadorTipos.relacional(parser.getTablaSimbolos(), ">=", a, b, opleft + 1, opright + 1); :}
            | expresion:a MENOR_IGUAL:op expresion:b
            {: RESULT = ManejadorTipos.relacional(parser.getTablaSimbolos(), "<=", a, b, opleft + 1, opright + 1); :}
            | expresion:a IGUAL_IGUAL:op expresion:b
            {: RESULT = ManejadorTipos.relacional(parser.getTablaSimbolos(), "==", a, b, opleft + 1, opright + 1); :}
            | expresion:a DISTINTO:op expresion:b
            {: RESULT = ManejadorTipos.relacional(parser.getTablaSimbolos(), "!=", a, b, opleft + 1, opright + 1); :}
            | PARENTESIS_A expresion:e PARENTESIS_C
            {: RESULT = ManejadorTipos.agrupar(e); :}
            | IDENTIFICADOR:obj PUNTO IDENTIFICADOR:n
            {: RESULT = parser.getTablaSimbolos().accederAtributo(obj,n,nleft+1,nright+1); :}
            | IDENTIFICADOR:n
            {: RESULT = ManejadorTipos.identificador(parser.getTablaSimbolos(), n, nleft + 1, nright + 1); :}
            | ENTERO:n {: RESULT = ManejadorTipos.literal("int", String.valueOf(n)); :}
            | DECIMAL:n {: RESULT = ManejadorTipos.literal("float", String.valueOf(n)); :}
            | CADENA:n {: RESULT = ManejadorTipos.literal("string", n); :}
            | TRUE {: RESULT = ManejadorTipos.literal("bool", "verdadero"); :}
            | FALSE {: RESULT = ManejadorTipos.literal("bool", "falso"); :}
            | llamada_metodo:m {: RESULT = m; :} ;

tipo_dato ::= INT {: RESULT = "int"; :}
            | FLOAT {: RESULT = "float"; :}
            | DOUBLE {: RESULT = "double"; :}
            | CHAR {: RESULT = "char"; :}
            | BOOL {: RESULT = "bool"; :}
            | STRING {: RESULT = "string"; :} ;
valor ::= ENTERO:n {: RESULT = String.valueOf(n); :}
        | DECIMAL:n {: RESULT = String.valueOf(n); :}
        | CADENA:n {: RESULT = n; :}
        | TRUE {: RESULT = "verdadero"; :}
        | FALSE {: RESULT = "falso"; :} ;

lista_identificadores ::= IDENTIFICADOR:n
              {: java.util.List l = new java.util.ArrayList();
                 l.add(new TablaSimbolos.Referencia(n, nleft + 1, nright + 1));
                 RESULT = l; :}
              | lista_identificadores:lista COMA IDENTIFICADOR:n
              {: lista.add(new TablaSimbolos.Referencia(n, nleft + 1, nright + 1));
                 RESULT = lista; :} ;
atributo_variable ::= tipo_dato:t lista_identificadores:ids PUNTO_COMA
              {: for (Object obj : ids) {
                     TablaSimbolos.Referencia r = (TablaSimbolos.Referencia) obj;
                     parser.getTablaSimbolos().registrar(r.id, "ATRIBUTO", t,
                         "sin_inicializar", r.linea, r.columna);
                 } :}
              | tipo_dato:t lista_identificadores:ids IGUAL expresion:v PUNTO_COMA
              {: for (Object obj : ids) {
                     TablaSimbolos.Referencia r = (TablaSimbolos.Referencia) obj;
                     parser.getTablaSimbolos().registrarInicializado(r.id, "ATRIBUTO", t, v,
                         r.linea, r.columna);
                 } :} ;
constante ::= CONST tipo_dato:t IDENTIFICADOR:n IGUAL expresion:v PUNTO_COMA
            {: parser.getTablaSimbolos().registrarInicializado(n, "CONSTANTE", t, v,
                       nleft + 1, nright + 1); :}
          | CONST tipo_dato:t IDENTIFICADOR:n PUNTO_COMA
            {: parser.getTablaSimbolos().error(nleft + 1, nright + 1,
                       "La constante '" + n + "' requiere un valor inicial obligatorio.");
               parser.getTablaSimbolos().registrar(n, "CONSTANTE", t,
                       "sin_inicializar", nleft + 1, nright + 1); :} ;
