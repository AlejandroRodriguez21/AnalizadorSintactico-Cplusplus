/* CENTENO DOMINGUEZ EDGAR YAIR, RAMOS GUTIERREZ RODRIGO, RODRIGUEZ ROMERO ALEJANDRO */
package ManejoErrores;
import java_cup.runtime.*;

parser code {:
    @Override
    public void report_error(String message, Object info) {
        StringBuilder m = new StringBuilder("Error sintactico");
        if (info instanceof java_cup.runtime.Symbol) {
            java_cup.runtime.Symbol s = ((java_cup.runtime.Symbol) info);
            if (s.left >= 0) {
                m.append(" en linea ").append(s.left + 1);
                if (s.right >= 0) m.append(", columna ").append(s.right + 1);
            }
            m.append(": se encontro '").append(s.value != null ? s.value : "TOKEN_DESCONOCIDO").append("'");
        }
        System.err.println(m.toString());
    }

    @Override
    public void report_fatal_error(String message, Object info) {
        StringBuilder m = new StringBuilder("Error fatal");
        if (info instanceof java_cup.runtime.Symbol) {
            java_cup.runtime.Symbol s = ((java_cup.runtime.Symbol) info);
            if (s.left >= 0) {
                m.append(" en linea ").append(s.left + 1);
                if (s.right >= 0) m.append(", columna ").append(s.right + 1);
            }
            m.append(": se encontro '").append(s.value != null ? s.value : "TOKEN_DESCONOCIDO").append("'");
        }
        System.err.println(m.toString());
        System.exit(1);
    }
:};

/* TIPOS DE DATO */
terminal INT, FLOAT, DOUBLE, CHAR, VOID, BOOL, LONG, SHORT, STRING;
terminal IF, ELSE, SWITCH, CASE, DEFAULT, FOR, WHILE, DO, BREAK, CONTINUE;
terminal CLASS, STRUCT, PUBLIC, PRIVATE, PROTECTED, THIS, NEW, DELETE, RETURN, USING, NAMESPACE, STD, COUT, CIN, ENDL, IMPORT, CONST;
terminal IGUAL_IGUAL, DISTINTO, MAYOR_IGUAL, MENOR_IGUAL, AND, OR, NOT;
terminal MAS, MENOS, POR, ENTRE, MODULO, IGUAL, MENOR, MAYOR, MENOR_MENOR, MAYOR_MAYOR;
terminal PUNTO_COMA, COMA, PUNTO, DOS_PUNTOS, PARENTESIS_A, PARENTESIS_C, CORCHETE_A, CORCHETE_C, LLAVE_A, LLAVE_C;

/* IDENTIFICADORES Y VALORES DE C++ */
terminal String IDENTIFICADOR, CADENA;
terminal Integer ENTERO;
terminal Double DECIMAL;
terminal TRUE, FALSE;

/* NO TERMINALES ESTRUCTURA BASE */
non terminal archivo, paquete_opcional, lista_importaciones, importacion, clase_principal;

/* NO TERMINALES ACTIVIDAD 5 */
non terminal cuerpo_clase, lista_elementos_clase, elemento_clase;
non terminal atributo_variable, constante;
non terminal tipo_dato, valor, lista_identificadores;

start with archivo;

archivo ::= paquete_opcional lista_importaciones clase_principal
          {: System.out.println("Analisis sintactico finalizado correctamente"); :} 
        ;

paquete_opcional ::= USING NAMESPACE IDENTIFICADOR PUNTO_COMA 
                   {: System.out.println("Regla reconocida: directiva using namespace"); :}
                 | USING NAMESPACE STD PUNTO_COMA 
                   {: System.out.println("Regla reconocida: directiva using namespace"); :}
                 | USING error PUNTO_COMA 
                   {: System.err.println("-> Recuperacion: Se omitio paquete invalido."); :}
                 | /* vacio */
                 ;

lista_importaciones ::= lista_importaciones importacion
                      | /* vacio */
                      ;

importacion ::= IMPORT IDENTIFICADOR PUNTO_COMA
              {: System.out.println("Regla reconocida: importacion"); :}
            | IMPORT error PUNTO_COMA
              {: System.err.println("-> Recuperacion: Se omitio importacion invalida."); :}
            ;

clase_principal ::= CLASS IDENTIFICADOR LLAVE_A cuerpo_clase LLAVE_C
                  {: System.out.println("Regla reconocida: clase principal y estructura de llaves valida"); :}
                | CLASS error LLAVE_C
                  {: System.err.println("-> Recuperacion: Se omitio clase mal formada."); :}
                | error
                  {: System.err.println("Error fatal: Estructura general irrecuperable. Abortando."); System.exit(1); :}
                ;

/* ACTIVIDAD 5: REGLAS INTERNAS DE LA CLASE Y MENSAJES ESPECIFICOS */

cuerpo_clase ::= lista_elementos_clase
               {: System.out.println("Regla reconocida: Clase con miembros"); :}
               | /* Permite clase vacia */
               {: System.out.println("Regla reconocida: Clase vacia"); :}
               ;

lista_elementos_clase ::= lista_elementos_clase elemento_clase
                        | elemento_clase
                        ;

elemento_clase ::= atributo_variable
                 | constante
                 | error PUNTO_COMA 
                   {: System.err.println("Error: Declaracion invalida");
                      System.err.println("-> Recuperacion: Se omitio una declaracion invalida dentro de la clase."); :}
                 ;

tipo_dato ::= INT | FLOAT | DOUBLE | CHAR | BOOL | STRING ;

valor ::= ENTERO | DECIMAL | CADENA | TRUE | FALSE ;

atributo_variable ::= tipo_dato lista_identificadores PUNTO_COMA
                    {: System.out.println("Regla reconocida: Declaracion de atributo"); :}
                  | tipo_dato lista_identificadores IGUAL valor PUNTO_COMA
                    {: System.out.println("Regla reconocida: Inicializacion de atributo"); :}
                  ;

lista_identificadores ::= IDENTIFICADOR
                        | lista_identificadores COMA IDENTIFICADOR
                        ;

constante ::= CONST tipo_dato IDENTIFICADOR IGUAL valor PUNTO_COMA
            {: System.out.println("Regla reconocida: Declaracion de constante"); :}
          | CONST tipo_dato IDENTIFICADOR:id PUNTO_COMA
            {: System.err.println("Error: Constante debe inicializarse en linea " + (idleft + 1)); 
               System.err.println("-> Recuperacion: Constante mal formada omitida."); :}
          ;